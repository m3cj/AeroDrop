# AeroDrop — Environment Variables
# Copy this file to .env and fill in your values

# Database
POSTGRES_PASSWORD=aerodrop_dev

# Weather (get your free key at https://www.weatherapi.com/)
WEATHER_API_KEY= b826f1a732504e09b28191531262508

# MAVLink connection (only used when MOCK_MODE=false)
MAVLINK_CONNECTION=udpin:0.0.0.0:14550

# Telemetry mode
MOCK_MODE=true

# Video gateway (Jetsan/MediaMTX HLS output URL)
JETSAN_HLS_URL=http://localhost:8554/stream.m3u8

# Your drone's RTSP stream (used by Jetsan)
RTSP_SOURCE=rtsp://192.168.1.100:554/stream

# Development
DEBUG=false
